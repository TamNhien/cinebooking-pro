POSTGRES_DB=cinebooking
POSTGRES_USER=cinebooking
POSTGRES_PASSWORD=cinebooking
POSTGRES_PORT=5433

# Required. Generate a unique value with: powershell -ExecutionPolicy Bypass -File .\tools\init-env.ps1
# Never reuse the example value in a real environment.
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@cine.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin

FRONTEND_URL=http://localhost
PUBLIC_API_URL=/api

PAYMENT_PROVIDER=mock
PAYMENT_MOCK_ENABLED=true
PAYMENT_WINDOW_SECONDS=300
SEAT_HOLD_TTL_SECONDS=300
SEAT_MAX_PER_BOOKING=8
SEAT_PREVENT_SINGLE_GAP=true

# V40 loyalty & membership 2.0
# Earned/refunded/admin-credit point lots expire after this many months.
LOYALTY_POINT_EXPIRY_MONTHS=12
LOYALTY_EXPIRING_SOON_DAYS=30
LOYALTY_EXPIRY_SCAN_MS=3600000

# V38 refund/cancellation policy. Rates are decimal fractions (0.80 = 80%).
REFUND_FULL_REFUND_MINUTES=1440
REFUND_PARTIAL_AUTO_MINUTES=360
REFUND_MINIMUM_MINUTES=120
REFUND_PARTIAL_AUTO_RATE=0.80
REFUND_MANUAL_RATE=0.50
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost/payment/result
VNPAY_IPN_URL=http://localhost/api/payments/vnpay/ipn
MOMO_CREATE_URL=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_URL=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=http://localhost/payment/result
MOMO_IPN_URL=http://localhost/api/payments/momo/ipn

# Password reset email
RESET_TOKEN_MINUTES=30
DEV_RESET_LINK=false
MAIL_ENABLED=false

# Gmail SMTP example. Turn MAIL_ENABLED=true after filling a real Gmail address
# and a Google App Password (not your normal Gmail password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=your-email@gmail.com
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000

# Poster upload storage inside Docker. Normally keep this default.
UPLOAD_DIR=/app/uploads

# Operations & security
CHECKIN_EARLY_MINUTES=2880
CHECKIN_LATE_MINUTES=240

# Absolute web origin embedded in V11 ticket QR codes.
# For real-phone LAN testing use your PC address, for example http://192.168.1.25
TICKET_PUBLIC_BASE_URL=
LOGIN_MAX_ATTEMPTS=5
LOGIN_IP_MAX_ATTEMPTS=20
LOGIN_LOCK_SECONDS=900
# V21 revocable sessions. Use REFRESH_COOKIE_SECURE=true behind production HTTPS.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_NAME=cinebooking_refresh

# Staff shifts / attendance
STAFF_TIME_ZONE=Asia/Ho_Chi_Minh
ATTENDANCE_START_EARLY_MINUTES=30
ATTENDANCE_START_LATE_MINUTES=60
ATTENDANCE_LATE_GRACE_MINUTES=5
ATTENDANCE_EARLY_LEAVE_GRACE_MINUTES=5
STAFF_SCAN_GRACE_MINUTES=30

# Dynamic pricing V18. Rules are evaluated in this cinema-local timezone.
PRICING_TIME_ZONE=Asia/Ho_Chi_Minh

# V41 notification center & engagement automation
STAFF_SHIFT_REMINDER_MINUTES=30
STAFF_SHIFT_SCAN_MS=60000
SHOWTIME_REMINDER_HOURS=3
SHOWTIME_FINAL_REMINDER_MINUTES=30
SHOWTIME_REMINDER_SCAN_MS=60000

# V42 immutable financial ledger & daily reconciliation
FINANCE_AUTO_RECONCILE_ENABLED=true
FINANCE_DAILY_CLOSE_CRON=0 10 1 * * *

# V36 secure ticket transfer
# A confirmed ticket can be transferred only before this cutoff and at most this many times.
TICKET_TRANSFER_CUTOFF_MINUTES=60
TICKET_MAX_TRANSFERS=1
