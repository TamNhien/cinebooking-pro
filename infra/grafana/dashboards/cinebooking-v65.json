      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "cinebooking:slo:availability_5m * 100", "legendFormat": "availability"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 99.9}]}}}
